use_default_settings: true

server:
  base_url: "http://localhost:8080/"
  # secret_keyは暗号化処理に使用されます。
  # セキュリティのため、環境変数 SEARXNG_SECRET 経由で設定することを推奨します。
  secret_key: ""
  bind_address: "0.0.0.0"
  port: 8080

redis:
  url: "redis://redis:6379/0"

search:
  formats:
    - html
    - json

# Enable a few search engines by default for testing
engines:
  - name: "google"
    engine: "google"
    shortcut: "go"
    categories: ["general"]
  - name: "duckduckgo"
    engine: "duckduckgo"
    shortcut: "ddg"
    categories: ["general"]
  - name: "ahmia"
    disabled: true
  - name: "torch"
    disabled: true

